# CognoDB Cloud Connection Settings
# Sign up and create a free instance at https://console.cognodb.com/signup
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_generated_password_here

# Optional: Demo/Mock mode fallback when database is not yet configured
ENABLE_LOCAL_FALLBACK=true
